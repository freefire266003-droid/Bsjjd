-- Crosshair drag for mobile
local chDragging=false
local chStart, chOrig=Vector2.new(),Vector2.new()
crosshair.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        chDragging=true
        chStart=Vector2.new(input.Position.X,input.Position.Y)
        local absPos=crosshair.AbsolutePosition+crosshair.AbsoluteSize/2
        chOrig=Vector2.new(absPos.X,absPos.Y)
        input.Changed:Connect(function()
            if input.UserInputState==Enum.UserInputState.End then chDragging=false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if chDragging and (input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseMovement) then
        local delta=Vector2.new(input.Position.X,input.Position.Y)-chStart
        local newPos=chOrig+delta
        local sx,sy=Camera.ViewportSize.X,Camera.ViewportSize.Y
        newPos=Vector2.new(math.clamp(newPos.X,10,sx-10),math.clamp(newPos.Y,10,sy-10))
        crosshair.Position=UDim2.new(0,newPos.X,0,newPos.Y)
    end
end)

-- ===== AIMBOT CORE (Easing smoothing) =====
local function isValidTarget(p)
    if not p or not p.Character then return false end
    local humanoid=p.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health<=0 then return false end
    if cfg.TeamCheck and LocalPlayer.Team and p.Team and LocalPlayer.Team==p.Team then return false end
    return true
end

local function predictPosition(part,origin)
    if not cfg.Prediction then return part.Position end
    local vel=part.AssemblyLinearVelocity or Vector3.new()
    local dist=(part.Position-origin).Magnitude
    local t=0
    if cfg.ProjectileSpeed>0 then t=dist/cfg.ProjectileSpeed end
    return part.Position+vel*t
end

local function getAimRef()
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        return Vector2.new(crosshair.AbsolutePosition.X+crosshair.AbsoluteSize.X/2,crosshair.AbsolutePosition.Y+crosshair.AbsoluteSize.Y/2)
    else
        local mouse=LocalPlayer:GetMouse()
        return Vector2.new(mouse.X,mouse.Y)
    end
end

local function getClosestTarget()
    local best=nil
    local bestDist=cfg.FOV
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local ref=getAimRef()
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer and isValidTarget(p) then
            local part=p.Character:FindFirstChild(cfg.TargetPart) or p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local vp=Camera:WorldToViewportPoint(part.Position)
                if vp.Z>0 then
                    local screenPos=Vector2.new(vp.X,vp.Y)
                    local dist=(screenPos-ref).Magnitude
                    if dist<=cfg.FOV and dist<bestDist then bestDist=dist; best=p end
                end
            end
        end
    end
    return best
end

local function aimAtPart(part)
    if not part or not Camera then return end
    local origin=Camera.CFrame.Position
    local target=predictPosition(part,origin)
    local desired=(target-origin).Unit
    -- Easing smoothing
    local curLook=Camera.CFrame.LookVector
    local alpha=math.clamp(cfg.Smoothness,0.01,1)
    -- easing easeOutQuad
    local eased=Vector3.new(
        curLook.X + (desired.X - curLook.X)*(alpha^0.5),
        curLook.Y + (desired.Y - curLook.Y)*(alpha^0.5),
        curLook.Z + (desired.Z - curLook.Z)*(alpha^0.5)
    )
    Camera.CFrame=CFrame.new(origin,origin+eased.Unit)
end

