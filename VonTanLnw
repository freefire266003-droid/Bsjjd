-- ===== AIMBOT CORE (same logic as before, adapted to crosshair) =====
local function isValidTarget(p)
    if not p or not p.Character then return false end
    local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if cfg.TeamCheck and LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then
        return false
    end
    return true
end

local function predictPosition(part, origin)
    if not cfg.Prediction then return part.Position end
    local vel = part.AssemblyLinearVelocity or Vector3.new()
    local dist = (part.Position - origin).Magnitude
    local t = 0
    if cfg.ProjectileSpeed > 0 then t = dist / cfg.ProjectileSpeed end
    return part.Position + vel * t
end

local function getAimReferencePos()
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    if isMobile then
        return Vector2.new(
            crosshair.AbsolutePosition.X + crosshair.AbsoluteSize.X/2,
            crosshair.AbsolutePosition.Y + crosshair.AbsoluteSize.Y/2
        )
    else
        local mouse = LocalPlayer:GetMouse()
        return Vector2.new(mouse.X, mouse.Y)
    end
end

local function getClosestTarget()
    local best = nil
    local bestDist = cfg.FOV
    local originChar = LocalPlayer.Character
    if not originChar or not originChar:FindFirstChild("HumanoidRootPart") then return nil end
    local originPos = originChar.HumanoidRootPart.Position
    local ref = getAimReferencePos()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isValidTarget(p) then
            local part = p.Character:FindFirstChild(cfg.TargetPart) or p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local vp = Camera:WorldToViewportPoint(part.Position)
                if vp.Z > 0 then
                    local screenPos = Vector2.new(vp.X, vp.Y)
                    local dist = (screenPos - ref).Magnitude
                    if dist <= cfg.FOV and dist < bestDist then
                        bestDist = dist
                        best = p
                    end
                end
            end
        end
    end
    return best
end

local function aimAtPart(part)
    if not part or not Camera then return end
    local origin = Camera.CFrame.Position
    local target = predictPosition(part, origin)
    local desired = (target - origin).Unit
    local current = Camera.CFrame.LookVector
    local alpha = math.clamp(cfg.Smoothness, 0.01, 1)
    local newLook = current:Lerp(desired, alpha)
    Camera.CFrame = CFrame.new(origin, origin + newLook)
end

RunService.RenderStepped:Connect(function()
    -- update fov handle if UI updated by code
    -- (nothing heavy here)
    if cfg.Enabled then
        local targetPlayer = getClosestTarget()
        if targetPlayer and targetPlayer.Character then
            local part = targetPlayer.Character:FindFirstChild(cfg.TargetPart) or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if part then
                aimAtPart(part)
            end
        end
    end
end)

