-- Crosshair drag (mobile friendly)
local chDragging = false
local chDragStart = Vector2.new()
local chOrig = Vector2.new()
crosshair.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        chDragging = true
        chDragStart = Vector2.new(input.Position.X, input.Position.Y)
        local absPos = crosshair.AbsolutePosition + crosshair.AbsoluteSize/2
        chOrig = Vector2.new(absPos.X, absPos.Y)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then chDragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if chDragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - chDragStart
        local newPos = chOrig + delta
        local sx, sy = Camera.ViewportSize.X, Camera.ViewportSize.Y
        newPos = Vector2.new(math.clamp(newPos.X, 10, sx-10), math.clamp(newPos.Y, 10, sy-10))
        crosshair.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
    end
end)

