-- Initial state
local state = {
    enabled = false,
    teamIgnore = true,
    fov = 120
}

-- Helpers for animations
local function pulseIndicator(on)
    local goal = on and theme.Accent or Color3.fromRGB(60,60,64)
    TweenService:Create(indicator, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundColor3 = goal}):Play()
end

local function updateToggleUI()
    toggle.Text = "AIM: " .. (state.enabled and "ON" or "OFF")
    local innerGoal = state.enabled and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,200)
    TweenService:Create(indInner, TweenInfo.new(0.18), {BackgroundColor3 = innerGoal}):Play()
    pulseIndicator(state.enabled)
    -- fire event to main script (UI-only)
    AimToggleEvent:Fire(state.enabled)
end

local function updateTeamUI()
    teamBtn.Text = "Ignore Team: " .. (state.teamIgnore and "ON" or "OFF")
    teamBtn.TextColor3 = state.teamIgnore and theme.Text or theme.Muted
end

local function updateFovUI()
    local rel = math.clamp((state.fov - 20) / (600 - 20), 0, 1)
    fovFill:TweenSize(UDim2.new(rel, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.12, true)
    fovHandle:TweenPosition(UDim2.new(rel, -12, 0.5, -12), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.12, true)
    fovLabel.Text = "FOV: " .. tostring(state.fov) .. " px"
    FovChangedEvent:Fire(state.fov)
end

-- Interactions
toggle.MouseButton1Click:Connect(function()
    state.enabled = not state.enabled
    updateToggleUI()
end)

teamBtn.MouseButton1Click:Connect(function()
    state.teamIgnore = not state.teamIgnore
    -- subtle flash
    TweenService:Create(teamBtn, TweenInfo.new(0.12), {BackgroundColor3 = theme.Accent}):Play()
    wait(0.12)
    teamBtn.BackgroundColor3 = theme.Bg
    updateTeamUI()
end)

-- Slider drag
local dragging = false
local function sliderUpdateFromX(x)
    local absX = fovSlider.AbsolutePosition.X
    local width = fovSlider.AbsoluteSize.X
    local rel = math.clamp((x - absX) / width, 0, 1)
    state.fov = math.floor(20 + rel * (600 - 20))
    updateFovUI()
end

fovHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
fovSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderUpdateFromX(input.Position.X)
        dragging = true
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        sliderUpdateFromX(input.Position.X)
    end
end)

-- Center & Reset fire events other scripts can listen to
crossPreview.MouseButton1Click:Connect(function()
    CenterRequested:Fire()
end)
resetBtn.MouseButton1Click:Connect(function()
    -- reset local state then broadcast ResetRequested
    state.fov = 120
    state.enabled = false
    state.teamIgnore = true
    updateFovUI()
    updateToggleUI()
    updateTeamUI()
    ResetRequested:Fire()
end)

-- initial render
updateFovUI()
updateTeamUI()
updateToggleUI()

