-- Modern UI (UI-only) for mobile-friendly testing
-- Fires BindableEvents instead of directly toggling aimbot logic.
-- Safe: does not touch aim/target code.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

-- BindableEvents (create once in PlayerGui so other scripts can listen)
local function getOrCreateEvent(name)
    local e = playerGui:FindFirstChild(name)
    if not e then
        e = Instance.new("BindableEvent")
        e.Name = name
        e.Parent = playerGui
    end
    return e
end

local AimToggleEvent = getOrCreateEvent("AimToggleEvent")        -- fires: AimToggleEvent:Fire(boolean)
local FovChangedEvent = getOrCreateEvent("FovChangedEvent")      -- fires: FovChangedEvent:Fire(number)
local ResetRequested = getOrCreateEvent("AimbotUIReset")         -- fires: ResetRequested:Fire()
local CenterRequested = getOrCreateEvent("AimbotUICenter")       -- fires: CenterRequested:Fire()

-- Theme (adjustable)
